{% extends 'base.html.twig' %}

{% block title %}Ingreso - Semantica Docs{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/login.css') }}">
{% endblock %}

{% block body %}
<div class="login">
    <section class="login-marca">
        <div class="login-marca-logo">
            <img src="{{ asset('images/semantica/logo-claro.png') }}" alt="Semantica Digital">
        </div>
        <div>
            <div class="login-producto">Semantica Docs</div>
            <h1>Documentación de nuestras soluciones</h1>
            <p>Manuales, procesos y guías técnicas de los productos de Semantica Digital reunidos en un solo lugar, siempre actualizados.</p>
        </div>
        <div class="login-marca-pie">
            © {{ "now"|date("Y") }} Semantica Digital · <a href="https://semantica.com.co" target="_blank" rel="noopener">semantica.com.co</a>
        </div>
    </section>

    <main class="login-form">
        <div class="login-card">
            <img src="{{ asset('images/semantica/logo.png') }}" alt="Semantica Digital" class="logo-completo">
            <h2>Iniciar sesión</h2>
            <div class="subtitulo">Ingrese al administrador de la documentación con su usuario y contraseña</div>

            {% if error %}
                <div class="login-error" role="alert">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    <span>{{ error.messageKey|trans(error.messageData, 'security') }}</span>
                </div>
            {% endif %}

            <form action="{{ path('login') }}" method="post">
                <div class="campo">
                    <label for="username">Usuario</label>
                    <div class="campo-control">
                        <span class="campo-icono">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        </span>
                        <input type="text" id="username" name="_username" value="{{ last_username }}"
                               autocomplete="username" required autofocus>
                    </div>
                </div>
                <div class="campo">
                    <label for="password">Contraseña</label>
                    <div class="campo-control">
                        <span class="campo-icono">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        </span>
                        <input type="password" id="password" name="_password" autocomplete="current-password" required>
                    </div>
                </div>

                <label class="recordarme">
                    <input type="checkbox" name="_remember_me">
                    Mantenerme conectado
                </label>

                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="btn btn-primario btn-ingresar">Ingresar</button>
            </form>

            <a href="{{ path('inicio') }}" class="login-volver">← Volver a la documentación</a>
        </div>
    </main>
</div>
{% endblock %}
